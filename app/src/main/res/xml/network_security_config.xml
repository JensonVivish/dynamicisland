<?xml version="1.0" encoding="utf-8"?>
<!-- DigiIsland does not use the internet. This config explicitly disables cleartext traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
